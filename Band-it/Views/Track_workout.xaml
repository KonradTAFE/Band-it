<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Band_it.Views.Track_workout"
             Style="{StaticResource Background_colors}">
    <VerticalStackLayout>
        <Label 
            Text="Workout tracking"
            VerticalOptions="Center" 
            HorizontalOptions="Center" 
            Margin="10"
            FontAttributes="Bold"/>
        <Image Source="body.png" HeightRequest="200" WidthRequest="300" />
        <HorizontalStackLayout Spacing="50" HorizontalOptions="Center" Margin="10">
            <Button Style="{StaticResource greyButtons}" x:Name="save_workout" Clicked="saveWorkout_clicked" Text="Save"></Button>
            <Button Style="{StaticResource greyButtons}" x:Name="add_exercise" Clicked="addExercise_clicked" Text="+"></Button>
        </HorizontalStackLayout>
        <ListView x:Name="tracking_exercises"></ListView>
    </VerticalStackLayout>
</ContentPage>