<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Band_it.Views.Add_band"
             Style="{StaticResource Background_colors}">
    <VerticalStackLayout>
        <Label 
            Text="New band"
            VerticalOptions="Center" 
            HorizontalOptions="Center" 
            FontSize="20"
            Margin="10"/>
        <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="*,*">
            <Label Grid.Column="1" Grid.Row="0" Text="Color" VerticalOptions="Center"/>
            <Picker x:Name="color_picker" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="0"  />
            <Label Grid.Column="1" Grid.Row="1" Text="Resistance" VerticalOptions="Center"/>
            <Label x:Name="resistance_value" Grid.Column="2" Grid.Row="1" Text="{Binding x:DataType='Stepper', Source={x:Reference _stepper}, Path=Value}" VerticalOptions="Center" HorizontalOptions="Center"/>
            <Stepper x:Name="_stepper" Grid.Column="3" Grid.Row="1" Increment="5" Value="10" Minimum="5" HorizontalOptions="End"/>
        </Grid>
        <HorizontalStackLayout HorizontalOptions="Center" Margin="5">
            <Button Style="{StaticResource greyButtons}" x:Name="save" Clicked="save_Clicked" Text="Save" Margin="5"/>
            <Button Style="{StaticResource greyButtons}" x:Name="back" Clicked="back_Clicked" Text="Back" Margin="5"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>